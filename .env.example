# EmailJS Contact Form Configuration
# Create a free account at https://www.emailjs.com/
# 1. Add an Email Service (e.g., Gmail connected to gourisharathore@gmail.com) -> Service ID
# 2. Create an Email Template with variables:
#    - {{from_name}}
#    - {{from_email}}
#    - {{subject}}
#    - {{message}}
# 3. Copy your Public Key from Account Settings > API Keys > Public Key
VITE_EMAILJS_SERVICE_ID=service_your_id
VITE_EMAILJS_TEMPLATE_ID=template_your_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# Optional Formspree endpoint alternative (if preferred over EmailJS)
# VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/your_form_id
